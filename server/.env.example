# Copy to .env and fill in. Never commit .env.
PORT=3000

# HTTP basic auth on every route except /health (real product data)
BASIC_AUTH_USER=newworks
BASIC_AUTH_PASS=change-me

# LLM: primary Gemini (OpenAI-compatible endpoint), fallback Groq. Both optional:
# without keys the app runs in "facts only" mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
