# Never send secrets or local build output into the image.
**/.env
**/node_modules
**/dist
.git
.idea
*.log

# Not needed at runtime: the app reads fact_sheet_facts.json, not the PDFs.
# (fact_sheets_text IS needed: the detail page shows the source lines a fact was read from.)
server/data/fact_sheets
server/scripts
server/src/**/*.test.ts
docs
